rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read and write their own data.
    // Path: users/{uid}/decks/{deckId}
    //       users/{uid}/flashcards/{cardId}
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared decks are publicly readable by any authenticated user so recipients
    // can import via a link. Only the owner can publish (create) or delete their
    // own share document. Updates are disallowed — shares are immutable.
    match /shared_decks/{shareId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }
  }
}
